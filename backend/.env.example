# ---- LiveKit (required) ---------------------------------------------------
# Copy from your LiveKit Cloud project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=lk_api_key
LIVEKIT_API_SECRET=lk_api_secret

# ---- Token server (required) ---------------------------------------------
# Shared secret the iOS client sends as X-Couch-Auth. Anything long + random.
COUCH_API_SHARED_SECRET=change-me-to-a-long-random-string
TOKEN_SERVER_PORT=8787

# ---- LLM (required for the agent) ----------------------------------------
OPENAI_API_KEY=sk-...

# ---- TTS (recommended - preserves Marcus's voice) ------------------------
# If unset, the agent falls back to OpenAI TTS. LiveKit TTS supersedes any
# voice/personality configured on the LemonSlice agent side.
ELEVENLABS_API_KEY=
# ElevenLabs voice ID for Marcus. Optional; agent has a sensible default.
ELEVENLABS_MARCUS_VOICE_ID=

# ---- Avatars (optional - feature-flag controlled) -------------------------
# Enable avatars globally. If unset/false, the agent runs audio-only and the
# iOS client falls back to the static ScenarioPortraitView.
COUCH_AVATARS_ENABLED=true

# One of: lemonslice | none. `none` disables avatars regardless of the flag.
COUCH_AVATAR_PROVIDER=lemonslice

LEMONSLICE_API_KEY=

# For Marcus specifically, set EITHER a LemonSlice agent ID OR a public image
# URL. If both are set, the agent ID wins. If neither is set, the session
# still runs audio-only — this is the documented fallback path.
MARCUS_LEMONSLICE_AGENT_ID=
MARCUS_LEMONSLICE_IMAGE_URL=

# How long to wait for the avatar worker to start before falling back to
# audio-only (seconds).
COUCH_AVATAR_START_TIMEOUT_SECONDS=8

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=info
