<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>OPENAI_API_KEY</key>
	<string>sk-replace-me</string>

	<!-- Legacy direct-ElevenLabs transport (used when COUCH_LIVEKIT_ENABLED is NO). -->
	<key>ELEVENLABS_API_KEY</key>
	<string>optional_replace_with_elevenlabs_api_key_for_private_agent_flows</string>
	<key>MARCUS_AGENT_ID</key>
	<string>agent_replace_with_elevenlabs_public_agent_id</string>

	<!-- LiveKit + LemonSlice avatar transport. Flip to YES to enable. -->
	<key>COUCH_LIVEKIT_ENABLED</key>
	<string>NO</string>
	<key>COUCH_AVATARS_ENABLED</key>
	<string>NO</string>

	<!-- Base URL for the Couch backend (see backend/). The app hits
	     `${COUCH_BACKEND_URL}/v1/sessions/token`. -->
	<key>COUCH_BACKEND_URL</key>
	<string>https://your-couch-backend.example.com</string>

	<!-- Shared secret the backend expects in the X-Couch-Auth header.
	     Must match COUCH_API_SHARED_SECRET on the server. -->
	<key>COUCH_BACKEND_SHARED_SECRET</key>
	<string>replace_with_long_random_shared_secret</string>
</dict>
</plist>
